parameters:
	level: 8

	paths:
		- src
		- tests

	# generated DI container of the test suite
	excludePaths:
		analyse:
			- tests/temp/*

	stubFiles:
		- tests/phpstan/Assert.stub

	ignoreErrors:
		# DatatypeCaseTest deliberately assigns values of a wrong type to verify that the entity rejects them at runtime
		-
			identifier: assign.propertyType
			path: tests/cases/OrmTest/DatatypeCaseTest.php

	tmpDir: %currentWorkingDirectory%/temp/phpstan
